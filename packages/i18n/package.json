{
  "name": "@vetoexpress/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalogs": "./src/catalogs.ts"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "format": "prettier --write \"{src,scripts,catalogs,project.inlang}/**/*.{ts,mjs,json}\" --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^2.11.4",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-icu1": "1.3.8"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
