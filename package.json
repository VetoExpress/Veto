{
  "name": "Veto",
  "version": "0.151.2",
  "description": "Veto —— A modern, cross-platform, and extensible Model United Nations Conference platform.",
  "author": "Miaoyww",
  "homepage": "https://veto.miaoyww.top",
  "repository": "https://github.com/Miaoyww/Veto",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "i18n:compile": "pnpm --filter @vetoexpress/frontend i18n:compile",
    "dev:electron": "pnpm --filter \"@vetoexpress/electron\" dev",
    "dev:frontend": "pnpm --filter \"@vetoexpress/frontend\" dev",
    "proxy": "node scripts/api-proxy.mjs",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format && prettier --write \"tests/load/**/*.{ts,mjs,json,md}\" --ignore-path .gitignore",
    "typecheck": "pnpm i18n:compile && pnpm -r typecheck && pnpm typecheck:load",
    "build:frontend": "pnpm --filter @vetoexpress/frontend build",
    "build:electron": "pnpm --filter @vetoexpress/electron build",
    "build:win": "pnpm build:frontend && node scripts/copy-frontend.mjs && npm --prefix apps/electron run build:win",
    "build:mac": "pnpm build:frontend && node scripts/copy-frontend.mjs && npm --prefix apps/electron run build:mac",
    "build": "pnpm build:win",
    "test": "pnpm i18n:compile && vitest run",
    "test:e2e": "playwright test",
    "test:load": "node tests/load/run.mjs",
    "test:load:local": "node tests/load/local/start.mjs",
    "typecheck:load": "tsc -p tests/load/tsconfig.json",
    "sync-version": "tsx scripts/sync-version.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/k6": "2.3.1",
    "eslint": "^9.39.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
